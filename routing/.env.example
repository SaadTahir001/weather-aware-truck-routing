MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
# MAPBOX_API_KEY is also accepted as an alias for MAPBOX_ACCESS_TOKEN.
OPENWEATHER_API_KEY=replace-with-openweather-key

# Optional tuning
# auto: mock only for missing/rejected keys; always: force mock; never: live only
ROUTING_MOCK_MODE=auto
MAPBOX_DIRECTIONS_PROFILE=mapbox/driving-traffic
ROUTE_CHECKPOINT_INTERVAL_MILES=50
ROUTE_MAX_CHECKPOINTS=200
EXTERNAL_API_TIMEOUT_SECONDS=15
OPENWEATHER_MAX_FORECAST_GAP_SECONDS=5400

# Optional provider base URL overrides, useful with a test stub or proxy
MAPBOX_API_BASE_URL=https://api.mapbox.com
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
